{
  "name": "@plane/summon-contract",
  "version": "1.4.2",
  "private": true,
  "description": "Summon API contract generated from Django: OpenAPI schema, Effect HTTP client and the tool manifest",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat.ts",
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "./scripts/schema.sh && bun run generate:client",
    "generate:client": "bun scripts/generate.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src openapi.json",
    "test": "vitest run",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf node_modules"
  },
  "dependencies": {
    "effect": "catalog:effect4"
  },
  "devDependencies": {
    "@effect/openapi-generator": "catalog:effect4",
    "@effect/platform-node": "catalog:effect4",
    "@plane/types": "workspace:*",
    "@plane/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "ai": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
