{
  "name": "@plane/tailwind-config",
  "version": "1.4.2",
  "private": true,
  "description": "common tailwind configuration across monorepo",
  "license": "AGPL-3.0",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "tailwind.config.js",
