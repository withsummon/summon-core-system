{
  "name": "@summon/convex",
  "private": true,
  "type": "module",
  "exports": {
    "./cycle-calendar": "./convex/cycles/dates.ts",
    "./api": "./convex/_generated/api.js",
    "./data-model": "./convex/_generated/dataModel.d.ts"
  },
  "scripts": {
    "dev": "convex dev --typecheck disable",
    "deploy": "pnpm check:types && convex deploy --typecheck disable",
    "codegen": "convex codegen --typecheck disable",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint --deny-warnings .",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "@convex-dev/auth": "catalog:",
    "@plane/editor": "workspace:*",
    "convex": "catalog:",
    "sanitize-html": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "convex-test": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
