# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

# *****************************************************************************
# STAGE 1: Collect workspace manifests
# *****************************************************************************
FROM base AS manifests
WORKDIR /src
COPY . .
# Every workspace manifest plus the lockfile: the install layer depends only on these,
# so it stays cached until dependencies change.
RUN mkdir -p /out && cp package.json bun.lock bunfig.toml /out/ \
  && for f in apps/*/package.json packages/*/package.json; do mkdir -p "/out/$(dirname "$f")" && cp "$f" "/out/$f"; done

# *****************************************************************************
# STAGE 2: Install dependencies & build the project
# *****************************************************************************
FROM base AS installer
# Bun installs dependencies; it is build-only and never reaches the runtime image.
COPY --from=oven/bun:1.4.2-alpine /usr/local/bin/bun /usr/local/bin/bun
ARG TURBO_VERSION=2.9.18
RUN bun add -g turbo@${TURBO_VERSION}
ENV PATH="/root/.bun/bin:$PATH"
RUN apk update
RUN apk add --no-cache libc6-compat
WORKDIR /app

# First install dependencies (as they change less often)
COPY --from=manifests /out/ .
RUN --mount=type=cache,id=bun-install,target=/root/.bun/install/cache \
  bun install --frozen-lockfile --filter=live
COPY . .

ENV TURBO_TELEMETRY_DISABLED=1

RUN turbo run build --filter=live

# *****************************************************************************
# STAGE 3: Run the project
# *****************************************************************************

FROM base AS runner
WORKDIR /app

# Remove go from Alpine APK database; not needed at runtime and carries stdlib CVEs
RUN apk del go 2>/dev/null || true

# Remove vulnerable picomatch bundled inside npm (CVE-2026-33671); npm is not used at runtime
RUN rm -rf /usr/local/lib/node_modules/npm/node_modules/picomatch

COPY --from=installer /app/packages ./packages
COPY --from=installer /app/apps/live/dist ./apps/live/dist
COPY --from=installer /app/apps/live/node_modules ./apps/live/node_modules
COPY --from=installer /app/node_modules ./node_modules
COPY --from=installer /app/apps/live/package.json ./apps/live/package.json

# esbuild and tsgolint are build-only Go binaries; remove from runtime image to eliminate stdlib CVEs
RUN find /app/node_modules \( -name 'esbuild' -o -name 'tsgolint' \) -type f -delete 2>/dev/null || true

ENV TURBO_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["node", "apps/live"]
