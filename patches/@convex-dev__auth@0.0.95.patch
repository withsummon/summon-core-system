diff --git a/dist/server/implementation/mutations/accountSession.js b/dist/server/implementation/mutations/accountSession.js
new file mode 100644
index 0000000000000000000000000000000000000000..47cb24b2bb271e169df9641593d3d74efd0fe3ba
--- /dev/null
+++ b/dist/server/implementation/mutations/accountSession.js
@@ -0,0 +1,37 @@
+import { v } from "convex/values";
+import { deleteSession } from "../sessions.js";
+import { TOKEN_SUB_CLAIM_DIVIDER } from "../utils.js";
+export const accountSession = v.object({
+    userId: v.id("users"),
+    sessionId: v.id("authSessions")
+});
+export async function prepareAccountSession(ctx, binding) {
+    const identity = await ctx.auth.getUserIdentity();
+    if (identity?.subject !== `${binding.userId}${TOKEN_SUB_CLAIM_DIVIDER}${binding.sessionId}`) throw new Error("Credential session changed.");
+    const session = await ctx.db.get(binding.sessionId);
+    const user = await ctx.db.get(binding.userId);
+    if (!session || session.userId !== binding.userId || session.expirationTime <= Date.now() || !user) throw new Error("Credential session expired or revoked.");
+    const sessions = await ctx.db.query("authSessions").withIndex("userId", (q)=>q.eq("userId", binding.userId)).take(101);
+    if (sessions.length > 100) throw new Error("Session cleanup limit exceeded. No credentials changed.");
+    const others = sessions.filter((row)=>row._id !== binding.sessionId);
+    let remaining = 1000;
+    for (const other of others){
+        const tokens = await ctx.db.query("authRefreshTokens").withIndex("sessionIdAndParentRefreshTokenId", (q)=>q.eq("sessionId", other._id)).take(remaining + 1);
+        if (tokens.length > remaining) throw new Error("Token cleanup limit exceeded. No credentials changed.");
+        remaining -= tokens.length;
+    }
+    return {
+        user,
+        async revokeOthers () {
+            for (const other of others)await deleteSession(ctx, other);
+        }
+    };
+}
+export async function preparePasswordSetup(ctx, binding, providerId, account, profile, shouldLinkViaEmail) {
+    const guarded = await prepareAccountSession(ctx, binding);
+    if (providerId !== "password" || !account.secret || guarded.user.emailVerificationTime === undefined || guarded.user.email !== account.id || profile.email !== account.id || !shouldLinkViaEmail) throw new Error("Verified current email is required to set a password.");
+    const ownAccounts = await ctx.db.query("authAccounts").withIndex("userIdAndProvider", (q)=>q.eq("userId", guarded.user._id).eq("provider", providerId)).take(1);
+    const sameEmail = await ctx.db.query("users").withIndex("email", (q)=>q.eq("email", account.id)).filter((q)=>q.neq(q.field("emailVerificationTime"), undefined)).take(2);
+    if (ownAccounts.length || sameEmail.length !== 1 || sameEmail[0]._id !== guarded.user._id) throw new Error("Password is already set or account email is ambiguous.");
+    return guarded;
+}
